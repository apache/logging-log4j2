<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">

<!-- A referenced appender must work even when its <appender> element comes
     after the logger that references it. Note this intentionally violates the
     element order of log4j.dtd, so parsing logs validation warnings. -->
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">
  <root>
    <priority value="debug" />
    <appender-ref ref="late" />
  </root>

  <appender name="late" class="org.apache.log4j.ListAppender">
    <layout class="org.apache.log4j.PatternLayout">
      <param name="ConversionPattern" value="%m%n" />
    </layout>
  </appender>

</log4j:configuration>
