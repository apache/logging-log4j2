<Configuration status="WARN">
  <Appenders>
    <!-- Missing the required fileName attribute. -->
    <File name="NoFileName" append="false" immediateFlush="true">
      <PatternLayout pattern="%m%n"/>
    </File>
    <!-- Missing the required text attribute. -->
    <RandomAccessFile name="Host" fileName="target/4488-host.log" append="false">
      <PatternLayout pattern="%m%n"/>
      <StringMatchFilter onMatch="DENY" onMismatch="NEUTRAL"/>
    </RandomAccessFile>
    <!-- Only bogusAttr is a genuinely invalid attribute. -->
    <Console name="Typo" bogusAttr="1">
      <PatternLayout pattern="%m%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <!-- Missing the required ref attribute. -->
    <Logger name="noref" level="INFO" additivity="false">
      <AppenderRef level="DEBUG"/>
    </Logger>
    <Root level="INFO">
      <AppenderRef ref="Host"/>
    </Root>
  </Loggers>
</Configuration>
