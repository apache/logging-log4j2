<Configuration status="WARN">
  <Appenders>
    <File name="File" fileName="target/4488-file.log">
      <PatternLayout pattern="%m%n"/>
    </File>
    <RandomAccessFile name="Host" fileName="target/4488-valid-host.log">
      <PatternLayout pattern="%m%n"/>
      <StringMatchFilter text="test" onMatch="DENY" onMismatch="NEUTRAL"/>
    </RandomAccessFile>
    <Console name="Console">
      <PatternLayout pattern="%m%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="valid" level="INFO" additivity="false">
      <AppenderRef ref="Host"/>
    </Logger>
    <Root level="INFO">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
